{
  "retriever": "hybrid",
  "docs_path": "data/railway",
  "eval_path": "data/railway/eval_dev.jsonl",
  "chunk_size": 420,
  "chunk_overlap": 80,
  "top_k": 3,
  "bm25": {
    "k1": 1.5,
    "b": 0.75
  },
  "embedding": {
    "model": "BAAI/bge-small-zh-v1.5",
    "query_instruction": "为这个句子生成表示以用于检索相关文章：",
    "batch_size": 32
  },
  "hybrid": {
    "candidate_k": 10,
    "rrf_k": 60
  },
  "reranker": {
    "enabled": true,
    "model": "cross-encoder/mmarco-mMiniLMv2-L12-H384-v1",
    "candidate_k": 10,
    "batch_size": 4,
    "max_length": 512,
    "backend": "onnx",
    "model_file": "onnx/model_quint8_avx2.onnx"
  },
  "evidence_evaluation": true
}
